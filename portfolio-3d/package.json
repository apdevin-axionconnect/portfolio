{
  "name": "portfolio-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:os": "npm --prefix ../macos-portfolio run build -- --base=./ --outDir=../portfolio-3d/public/os --emptyOutDir",
    "predev": "npm run build:os",
    "prebuild": "npm run build:os",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "smoke": "node perf/smoke.mjs",
    "e2e": "node --test --test-concurrency=1 tests/",
    "og": "node scripts/make-og.mjs",
    "perf": "node perf/measure.mjs",
    "perf:compare": "node perf/measure.mjs compare"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "n8ao": "^2.0.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
